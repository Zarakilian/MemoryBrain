# CORE — required
BRAIN_PORT=7741
OLLAMA_URL=http://ollama:11434

# AUTHENTICATION (optional). With a key set, every write needs X-Brain-Key.
# Without one, the brain still answers only loopback Host names, and a write
# needs Content-Type: application/json or an X-Brain-Client header.
BRAIN_API_KEY=

# v3: extra Host names to accept besides localhost, 127.0.0.1 and [::1]
# (comma separated; applies to REST and to the MCP transports)
MEMORYBRAIN_ALLOWED_HOSTS=

# v3: the MCP tool list. core (default) lists 15 tools plus brain_admin for the
# rest; full lists every tool. Every tool stays callable either way.
MEMORYBRAIN_TOOLS=core

# v3: memories re-embedded per minute in the background after a model change
# or an upgrade (0 turns it off; search keeps working meanwhile)
MEMORYBRAIN_REEMBED_RATE=25

# v3: on = the model must confirm each contradiction the sleep cycle flags
MEMORYBRAIN_JUDGE=off

# SEARCH — recency decay (0 = disabled, 0.02 = ~12% decay per week)
RECENCY_DECAY_RATE=0.02

# v2.3 ranking feedback from record_retrieval chosen_id (0 = off)
MEMORYBRAIN_RETRIEVAL_FEEDBACK_WEIGHT=0.15

# v2.3 nightly light auto-sleep (default off)
# When true, the brain runs a light consolidation cycle once per UTC day
# after MEMORYBRAIN_CONSOLIDATE_HOUR (repair + conflicts + loops + decay;
# no LLM beliefs unless MEMORYBRAIN_AUTO_CONSOLIDATE_FULL=true).
MEMORYBRAIN_AUTO_CONSOLIDATE=false
MEMORYBRAIN_CONSOLIDATE_HOUR=3
MEMORYBRAIN_AUTO_CONSOLIDATE_FULL=false
MEMORYBRAIN_AUTO_ACTIVE_DAYS=14
MEMORYBRAIN_AUTO_IDLE_DAYS=14

# AI PROVIDER — chosen ONLY by MEMORYBRAIN_PROVIDER: ollama (default, fully
# local, no key), gemini or openai. A key on its own never switches provider,
# so a stray key cannot send memories to a cloud service.
MEMORYBRAIN_PROVIDER=ollama
# Gemini (Google AI): set MEMORYBRAIN_PROVIDER=gemini and the key below.
#   Get a key at https://aistudio.google.com/app/apikey (it starts with AIza).
#   /readiness tests connectivity at startup.
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_SUMMARISE_MODEL=gemini-2.0-flash

# OpenAI or OpenAI-compatible endpoint: set MEMORYBRAIN_PROVIDER=openai and the key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_SUMMARISE_MODEL=gpt-4o-mini

# Override Ollama model names (used when MEMORYBRAIN_PROVIDER=ollama)
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_SUMMARISE_MODEL=llama3.2:3b
