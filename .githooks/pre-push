#!/bin/sh
# Blocks a push that would publish machine data, secrets or brain data.
# Scans every commit being pushed: each file it adds or changes, and its message.
# Real names to block live in .local/hygiene-patterns.txt (git-ignored).
# Enable once per clone:  git config core.hooksPath .githooks
for py in python3 python; do
  if "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
    exec "$py" cli/check_repo_hygiene.py --push
  fi
done
echo "hygiene: no Python 3.9+ found on PATH, push blocked" >&2
exit 1
